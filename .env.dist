# Copy to `.env` and update each value for your environment.
ROBOFLOW_API_KEY=

# NASA Earthdata / Alaska Satellite Facility
# Preferred authentication for unattended downloads. Public search needs no login.
EARTHDATA_TOKEN=

# Alternative username/password authentication (or use a protected .netrc).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Local SAR storage configuration. Explicit CLI arguments take precedence.
MLX_SAR_OUTPUT_DIR=~/Desktop/datasets/sar
MLX_SAR_CACHE_DIR=~/.cache/mlx/sar

# Optional network configuration.
MLX_SAR_DOWNLOAD_PROCESSES=1
MLX_SAR_REQUEST_TIMEOUT=60
MLX_SAR_MAX_RETRIES=3

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDataset",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<DATASET_BUCKET>/<DATASET_OBJECT_KEY>.zip"
    },
    {
      "Sid": "ReadFineTuneModel",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<MODEL_BUCKET>/<MODEL_OBJECT_KEY>.pt"
    },
    {
      "Sid": "InspectTrainingBuckets",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::<DATASET_BUCKET>",
        "arn:aws:s3:::<CHECKPOINT_BUCKET>",
        "arn:aws:s3:::<MODEL_BUCKET>"
      ]
    },
    {
      "Sid": "ListDataset",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<DATASET_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<DATASET_OBJECT_KEY>.zip"
        }
      }
    },
    {
      "Sid": "ListFineTuneModel",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<MODEL_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<MODEL_OBJECT_KEY>.pt"
        }
      }
    },
    {
      "Sid": "ListCheckpointPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<CHECKPOINT_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<CHECKPOINT_PREFIX>/*"
        }
      }
    },
    {
      "Sid": "ManageTrainingArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<CHECKPOINT_BUCKET>/<CHECKPOINT_PREFIX>/*"
    },
    {
      "Sid": "PullTrainingImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<ACCOUNT_ID>:repository/<ECR_REPOSITORY>"
    },
    {
      "Sid": "AuthorizeEcrPull",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublishTrainingLogsAndMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
